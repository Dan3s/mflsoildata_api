# Development Environment Variables (TEMPLATE)
# Duplicate this file to .env and fill in your local values

# Database Connection (Required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soil_platform

# FastAPI Configuration (Optional)
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=True

# Logging (Optional)
# LOG_LEVEL=INFO

# Keycloak auth (Required for protected endpoints)
KEYCLOAK_ISSUER=http://localhost:8080/realms/mfl
# Only used when KEYCLOAK_VERIFY_AUD=true (requires an Audience mapper in Keycloak)
KEYCLOAK_AUDIENCE=mfl-api
KEYCLOAK_VERIFY_AUD=false
# LAN usability testing only (e.g. a coworker logging in through your IP
# instead of localhost): set to that IP (optionally "ip:port") to swap it into
# KEYCLOAK_ISSUER's host above when validating a token's `iss` claim. Mirrors
# AUTH_KEYCLOAK_LOCALTESTS in mflsoildata_frontend's .env, and also requires
# Keycloak's realm "Frontend URL" (Admin Console) set to that same IP. Leave
# empty the rest of the time.
# KEYCLOAK_LOCALTESTS=

# Keycloak admin (Required for the Users screen and to notify reviewers by email
# of a new submission). Service-account client with the realm-management roles
# 'view-users' and 'manage-users'.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Email notifications (Optional). Without SMTP_HOST, emails are only logged, so
# dev/CI never breaks — fill these in to actually send:
# - submitter: "your dataset is in review" / approved / rejected
# - reviewers (database_editor/admin): "new dataset pending review"
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@your-domain.org
# SMTP_TLS=true

# Base URL of the deployed frontend (Optional). Used only to build a link back
# to the review queue (/dashboard/logs) in the reviewer-notification email.
# FRONTEND_URL=https://your-frontend-domain.org

# Dataverse import (Optional). Defaults to the public demo instance, good for
# trying the feature out; point it at https://dataverse.harvard.edu (or your
# own installation) for real imports. DATAVERSE_API_TOKEN is a server-wide
# fallback — normally each import supplies its own token for a restricted
# dataset instead of relying on this.
# DATAVERSE_BASE_URL=https://demo.dataverse.org
# DATAVERSE_API_TOKEN=

# Chat assistant (Required for the Q&A chatbot). Free API key from
# https://aistudio.google.com/apikey — no billing needed for the free tier.
GOOGLE_API_KEY=
# Optional override; defaults to the free-tier gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
